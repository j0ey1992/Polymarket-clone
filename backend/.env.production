# ═══════════════════════════════════════════════════════════════════
# RAILWAY PRODUCTION ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════════
# Copy these to Railway Dashboard → Your Service → Variables

# ─────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ─────────────────────────────────────────────────────────────────────
# DATABASE (Railway provides these automatically)
# Use variable references: ${{Postgres.DATABASE_URL}}
# ─────────────────────────────────────────────────────────────────────
DATABASE_URL=${{Postgres.DATABASE_URL}}

# ─────────────────────────────────────────────────────────────────────
# REDIS (Railway provides these automatically)
# Use variable references: ${{Redis.REDIS_URL}}
# ─────────────────────────────────────────────────────────────────────
REDIS_URL=${{Redis.REDIS_URL}}

# ─────────────────────────────────────────────────────────────────────
# POLYMARKET API (Public - no keys needed for reading)
# ─────────────────────────────────────────────────────────────────────
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com
POLYMARKET_LIVE_WS_URL=wss://ws-live-data.polymarket.com

# ─────────────────────────────────────────────────────────────────────
# POLYMARKET TRADING (Required for placing orders on Polymarket)
# Generate a new wallet and fund it with USDC on Polygon
# ─────────────────────────────────────────────────────────────────────
POLYMARKET_PRIVATE_KEY=your_polygon_wallet_private_key
POLYMARKET_FUNDER_ADDRESS=your_polygon_wallet_address

# ─────────────────────────────────────────────────────────────────────
# CRONOS CHAIN (For your smart contracts)
# ─────────────────────────────────────────────────────────────────────
CRONOS_RPC_URL=https://evm.cronos.org
CRONOS_CHAIN_ID=25
CRONOS_PRIVATE_KEY=your_cronos_wallet_private_key
PREDICTION_MARKET_ADDRESS=deployed_contract_address
TREASURY_ADDRESS=deployed_treasury_address

# ─────────────────────────────────────────────────────────────────────
# SPREAD CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
BASE_SPREAD=0.05
MIN_SPREAD=0.03
MAX_SPREAD=0.10

# ─────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_a_64_character_random_string_here
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ─────────────────────────────────────────────────────────────────────
# FRONTEND URL (for CORS)
# ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.up.railway.app
