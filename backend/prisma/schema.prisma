generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(uuid())
  cronosAddress String     @unique @map("cronos_address")
  createdAt     DateTime   @default(now()) @map("created_at")
  positions     Position[]
  orders        Order[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  icon        String?
  marketCount Int      @default(0) @map("market_count")
  createdAt   DateTime @default(now()) @map("created_at")
  events      Event[]
  markets     Market[]

  @@map("categories")
}

model Event {
  id           String    @id @default(uuid())
  polymarketId String?   @unique @map("polymarket_id")
  slug         String    @unique
  title        String
  description  String?
  image        String?
  categoryId   String?   @map("category_id")
  category     Category? @relation(fields: [categoryId], references: [id])
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  active       Boolean   @default(true)
  featured     Boolean   @default(false)
  marketCount  Int       @default(0) @map("market_count")
  totalVolume  Decimal   @default(0) @map("total_volume") @db.Decimal(18, 2)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  markets      Market[]

  @@map("events")
}

model Market {
  id                    String          @id @default(uuid())
  polymarketConditionId String          @unique @map("polymarket_condition_id")
  polymarketTokenIdYes  String          @map("polymarket_token_id_yes")
  polymarketTokenIdNo   String          @map("polymarket_token_id_no")

  // Relations
  eventId               String?         @map("event_id")
  event                 Event?          @relation(fields: [eventId], references: [id])
  categoryId            String?         @map("category_id")
  category              Category?       @relation(fields: [categoryId], references: [id])

  // Market details
  question              String
  description           String?
  image                 String?
  slug                  String?

  // Timing
  startDate             DateTime?       @map("start_date")
  endDate               DateTime?       @map("end_date")

  // State
  active                Boolean         @default(true)
  closed                Boolean         @default(false)
  resolved              Boolean         @default(false)
  outcome               String?

  // Polymarket prices
  yesPrice              Decimal         @default(0.5) @map("yes_price") @db.Decimal(10, 6)
  noPrice               Decimal         @default(0.5) @map("no_price") @db.Decimal(10, 6)

  // YOUR prices (5% less - what users see)
  yourYesPrice          Decimal?        @map("your_yes_price") @db.Decimal(10, 6)
  yourNoPrice           Decimal?        @map("your_no_price") @db.Decimal(10, 6)

  // Stats
  volume24h             Decimal         @default(0) @map("volume_24h") @db.Decimal(18, 2)
  totalVolume           Decimal         @default(0) @map("total_volume") @db.Decimal(18, 2)
  liquidity             Decimal         @default(0) @db.Decimal(18, 2)

  // Metadata
  resolutionSource      String?         @map("resolution_source")
  tags                  String[]

  // Timestamps
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  positions             Position[]
  orders                Order[]
  hedgePositions        HedgePosition[]
  priceHistory          PriceHistory[]

  @@index([categoryId])
  @@index([eventId])
  @@index([active, resolved])
  @@index([totalVolume(sort: Desc)])
  @@map("markets")
}

model Position {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  marketId  String   @map("market_id")
  side      String
  size      Decimal  @db.Decimal(18, 6)
  avgPrice  Decimal  @map("avg_price") @db.Decimal(10, 6)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  market    Market   @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId, side])
  @@map("positions")
}

model Order {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  marketId          String        @map("market_id")
  side              String
  outcome           String
  size              Decimal       @db.Decimal(18, 6)
  price             Decimal       @db.Decimal(10, 6)
  spreadApplied     Decimal       @map("spread_applied") @db.Decimal(10, 6)
  effectivePrice    Decimal       @map("effective_price") @db.Decimal(10, 6)
  status            String        @default("PENDING")
  polymarketOrderId String?       @map("polymarket_order_id")
  cronosTxHash      String?       @map("cronos_tx_hash")
  createdAt         DateTime      @default(now()) @map("created_at")
  filledAt          DateTime?     @map("filled_at")
  user              User          @relation(fields: [userId], references: [id])
  market            Market        @relation(fields: [marketId], references: [id])
  spreadProfit      SpreadProfit?

  @@map("orders")
}

model SpreadProfit {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  amount    Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now()) @map("created_at")
  order     Order    @relation(fields: [orderId], references: [id])

  @@map("spread_profits")
}

model HedgePosition {
  id        String   @id @default(uuid())
  marketId  String   @map("market_id")
  side      String
  size      Decimal  @db.Decimal(18, 6)
  avgPrice  Decimal  @map("avg_price") @db.Decimal(10, 6)
  updatedAt DateTime @updatedAt @map("updated_at")
  market    Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, side])
  @@map("hedge_positions")
}

model PriceHistory {
  id        String   @id @default(uuid())
  marketId  String   @map("market_id")
  yesPrice  Decimal  @map("yes_price") @db.Decimal(10, 6)
  noPrice   Decimal  @map("no_price") @db.Decimal(10, 6)
  volume    Decimal? @db.Decimal(18, 2)
  timestamp DateTime @default(now())
  market    Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, timestamp(sort: Desc)])
  @@map("price_history")
}

model Balance {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  tradingBalance Decimal @default(0) @map("trading_balance") @db.Decimal(18, 6)
  lockedBalance Decimal  @default(0) @map("locked_balance") @db.Decimal(18, 6)
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("balances")
}

model Payout {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  marketId    String   @map("market_id")
  amount      Decimal  @db.Decimal(18, 6)
  positionSize Decimal @map("position_size") @db.Decimal(18, 6)
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  txHash      String?  @map("tx_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  error       String?

  @@index([userId])
  @@index([marketId])
  @@index([status])
  @@map("payouts")
}
